document.addEventListener('DOMContentLoaded', () => {
  const footer = document.querySelector('.jg-footer-row');

  if (!footer) {
    return;
  }

  const MAX_FONT_SIZE = 20;
  const MIN_FONT_SIZE = 15;
  const STEP = 0.5;

  let resizeFrame = null;

  /*
   * Diese Elemente sollen auf ungewollte Umbrüche
   * geprüft werden.
   *
   * Die Uhrzeitentexte werden bewusst nicht geprüft,
   * weil dort <br>-Umbrüche gewünscht sind.
   */
  const wrapSelectors = [
    '.jg-footer-location p',
    '.jg-footer-location a',
    '.jg-footer-customer a',
    '.jg-footer-customer li',
    '.jg-footer-customer .elementor-icon-list-text',
    '.jg-footer-legal a',
    '.jg-footer-legal li',
    '.jg-footer-legal .elementor-icon-list-text',
    '.jg-footer-social .elementor-heading-title',
    '.jg-footer-row h1',
    '.jg-footer-row h2',
    '.jg-footer-row h3',
    '.jg-footer-row h4',
    '.jg-footer-row h5',
    '.jg-footer-row h6',
    '.jg-footer-row .elementor-heading-title'
  ];

  function getElementsToCheck() {
    return [...footer.querySelectorAll(wrapSelectors.join(','))]
      .filter((element) => {
        /*
         * Die Überschrift der Öffnungszeiten darf geprüft werden,
         * die eigentlichen Uhrzeitentexte jedoch nicht.
         */
        return !element.closest('.ue_business_hours_list_item_text');
      });
  }

  function hasWrapped(element) {
    const style = window.getComputedStyle(element);
    const lineHeight = parseFloat(style.lineHeight);

    /*
     * Manche Browser liefern "normal".
     */
    const effectiveLineHeight = Number.isFinite(lineHeight)
      ? lineHeight
      : parseFloat(style.fontSize) * 1.2;

    const contentHeight =
      element.scrollHeight -
      parseFloat(style.paddingTop || 0) -
      parseFloat(style.paddingBottom || 0);

    return contentHeight > effectiveLineHeight * 1.45;
  }

  function footerHasUnwantedWrap() {
    return getElementsToCheck().some(hasWrapped);
  }

  function fitFooterText() {
    /*
     * Auf Tablet und Mobile darf das Raster umbrechen.
     * Dort wird lediglich die Standardschriftgröße genutzt.
     */
    if (window.innerWidth <= 1024) {
      footer.style.setProperty(
        '--jg-footer-font-size',
        `${MAX_FONT_SIZE}px`
      );

      return;
    }

    let fontSize = MAX_FONT_SIZE;

    footer.style.setProperty(
      '--jg-footer-font-size',
      `${fontSize}px`
    );

    /*
     * Browser erst neu layouten lassen.
     */
    void footer.offsetHeight;

    while (
      footerHasUnwantedWrap() &&
      fontSize > MIN_FONT_SIZE
    ) {
      fontSize -= STEP;

      footer.style.setProperty(
        '--jg-footer-font-size',
        `${fontSize}px`
      );

      void footer.offsetHeight;
    }
  }

  function scheduleFit() {
    window.cancelAnimationFrame(resizeFrame);

    resizeFrame = window.requestAnimationFrame(() => {
      fitFooterText();
    });
  }

  /*
   * Bei Größenänderungen des Footers erneut prüfen.
   */
  const resizeObserver = new ResizeObserver(scheduleFit);
  resizeObserver.observe(footer);

  /*
   * Nach dem Laden der Webfonts erneut prüfen,
   * weil sich dadurch Textbreiten ändern können.
   */
  if (document.fonts?.ready) {
    document.fonts.ready.then(scheduleFit);
  }

  window.addEventListener('resize', scheduleFit);

  scheduleFit();
});