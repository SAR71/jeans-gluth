/* =========================================================
   FOOTER – GRUNDLAYOUT
   ========================================================= */

.jg-footer-row {
  --jg-footer-font-size: 20px;

  display: grid !important;

  /*
   * 1. Anschrift
   * 2. Öffnungszeiten
   * 3. Kundenservice
   * 4. Rechtliches
   * 5. Social Media / verbleibender Platz bis rechts
   */
  grid-template-columns:
    minmax(280px, 340px)
    minmax(320px, 400px)
    minmax(190px, 230px)
    minmax(190px, 230px)
    minmax(max-content, 1fr);

  column-gap: clamp(30px, 3vw, 70px);
  align-items: start;

  /*
   * Aus einer eventuell begrenzten Elementor-
   * Inhaltsbreite auf die gesamte Fensterbreite ziehen.
   */
  width: 100vw !important;
  max-width: none !important;

  position: relative;
  left: 50%;

  margin-left: -50vw !important;
  margin-right: 0 !important;

  /*
   * Gewünschter Abstand zum linken und rechten Fensterrand.
   */
  padding-left: clamp(15px, 2.5vw, 50px);
  padding-right: clamp(15px, 2.5vw, 50px);

  box-sizing: border-box;
}


/* =========================================================
   DIREKTE FOOTER-CONTAINER
   ========================================================= */

.jg-footer-row > .e-con,
.jg-footer-row > .elementor-element {
  min-width: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}


/* =========================================================
   ANSCHRIFT
   ========================================================= */

.jg-footer-location {
  min-width: 0;
  width: 100%;
}


/* =========================================================
   ÖFFNUNGSZEITEN
   ========================================================= */

.jg-footer-hours {
  min-width: 0;
  width: 100%;
  max-width: 400px;
}


/* =========================================================
   KUNDENSERVICE UND RECHTLICHES
   ========================================================= */

.jg-footer-customer,
.jg-footer-legal {
  min-width: 0;
  width: 100%;
}

/*
 * Kein zusätzlicher Margin vor Kundenservice.
 * Der größere Abstand entsteht durch das Grid.
 */
.jg-footer-customer {
  margin-left: 0 !important;
}


/* =========================================================
   SOCIAL MEDIA GANZ RECHTS
   ========================================================= */

.jg-footer-social {
  width: max-content !important;
  min-width: max-content;

  justify-self: end !important;
  align-self: start;

  margin-left: 0 !important;
  margin-right: 0 !important;
}


/* =========================================================
   GEMEINSAME SCHRIFTGRÖSSE
   ========================================================= */

.jg-footer-row p,
.jg-footer-row a,
.jg-footer-row li,
.jg-footer-row .elementor-icon-list-text,
.jg-footer-row .ue_business_hours_list_item_title,
.jg-footer-row .ue_business_hours_list_item_text {
  font-size: var(--jg-footer-font-size) !important;
}


/* =========================================================
   ÜBERSCHRIFTEN
   ========================================================= */

.jg-footer-row .elementor-heading-title,
.jg-footer-row .ue_business_hours_header_title {
  font-size: calc(var(--jg-footer-font-size) * 1.05) !important;
}


/* =========================================================
   UNGEWOLLTE ZEILENUMBRÜCHE VERMEIDEN
   ========================================================= */

.jg-footer-customer .elementor-icon-list-text,
.jg-footer-legal .elementor-icon-list-text {
  white-space: nowrap;
}


/* =========================================================
   MITTLERE DESKTOPBREITEN
   ========================================================= */

@media (max-width: 1450px) {
  .jg-footer-row {
    grid-template-columns:
      minmax(250px, 300px)
      minmax(300px, 400px)
      minmax(175px, 215px)
      minmax(175px, 215px)
      minmax(max-content, 1fr);

    column-gap: clamp(20px, 2.2vw, 40px);
  }
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1024px) {
  .jg-footer-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 35px 30px;

    padding-left: 20px;
    padding-right: 20px;
  }

  .jg-footer-customer {
    margin-left: 0 !important;
  }

  .jg-footer-social {
    width: auto !important;
    min-width: 0;

    justify-self: start !important;

    margin-left: 0 !important;
    margin-right: 0 !important;
  }
}


/* =========================================================
   SMARTPHONE
   ========================================================= */

@media (max-width: 767px) {
  .jg-footer-row {
    grid-template-columns: minmax(0, 1fr);
    gap: 30px;

    padding-left: 15px;
    padding-right: 15px;
  }

  .jg-footer-hours {
    max-width: 400px;
  }

  .jg-footer-social {
    width: auto !important;
    justify-self: start !important;
  }
}