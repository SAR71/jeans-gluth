/* =========================================================
   FOOTER – ÄUSSERER ELEMENTOR-CONTAINER
   ========================================================= */

body .jg-footer-row {
  --jg-footer-font-size: 20px;

  /*
   * Elementor-Inhaltsbegrenzung aufheben.
   */
  --content-width: 100%;

  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;

  box-sizing: border-box;
}


/* =========================================================
   EIGENTLICHES FOOTER-GRID
   ========================================================= */

body .jg-footer-row > .e-con-inner {
  display: grid !important;

  /*
   * Spalten:
   *
   * 1 Anschrift
   * 2 Öffnungszeiten
   * 3 zusätzlicher Abstand
   * 4 Kundenservice
   * 5 Rechtliches
   * 6 Social Media
   */
  grid-template-columns:
    minmax(280px, 340px)
    minmax(320px, 400px)
    clamp(10px, 1.5vw, 35px)
    minmax(190px, 1fr)
    minmax(190px, 1fr)
    minmax(max-content, 1fr);

  column-gap: clamp(20px, 2vw, 45px);
  align-items: start;

  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;

  padding-left: clamp(15px, 2.5vw, 50px) !important;
  padding-right: clamp(15px, 2.5vw, 50px) !important;

  box-sizing: border-box;
}


/* =========================================================
   FOOTER-CONTAINER DEN SPALTEN ZUORDNEN
   ========================================================= */

body .jg-footer-row > .e-con-inner > .jg-footer-location {
  grid-column: 1;
}

body .jg-footer-row > .e-con-inner > .jg-footer-hours {
  grid-column: 2;
}

body .jg-footer-row > .e-con-inner > .jg-footer-customer {
  grid-column: 4;
}

body .jg-footer-row > .e-con-inner > .jg-footer-legal {
  grid-column: 5;
}

body .jg-footer-row > .e-con-inner > .jg-footer-social {
  grid-column: 6;
}


/* =========================================================
   GEMEINSAME CONTAINER-EINSTELLUNGEN
   ========================================================= */

body .jg-footer-row > .e-con-inner > .jg-footer-location,
body .jg-footer-row > .e-con-inner > .jg-footer-hours,
body .jg-footer-row > .e-con-inner > .jg-footer-customer,
body .jg-footer-row > .e-con-inner > .jg-footer-legal {
  min-width: 0 !important;
  width: 100% !important;
  max-width: 100% !important;

  margin: 0 !important;
  padding-left: 0 !important;
  padding-right: 0 !important;

  box-sizing: border-box;
}


/* =========================================================
   ÖFFNUNGSZEITEN
   ========================================================= */

body .jg-footer-hours {
  width: 100% !important;
  max-width: 400px !important;
}


/* =========================================================
   KUNDENSERVICE UND RECHTLICHES
   ========================================================= */

body .jg-footer-customer,
body .jg-footer-legal {
  min-width: 0 !important;
}


/* =========================================================
   SOCIAL MEDIA GANZ RECHTS
   ========================================================= */

body .jg-footer-row > .e-con-inner > .jg-footer-social {
  width: max-content !important;
  min-width: max-content !important;
  max-width: none !important;

  justify-self: end !important;
  align-self: start !important;

  margin: 0 !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
}


/* =========================================================
   GEMEINSAME SCHRIFTGRÖSSE
   ========================================================= */

body .jg-footer-row p,
body .jg-footer-row a,
body .jg-footer-row li,
body .jg-footer-row .elementor-icon-list-text,
body .jg-footer-row .ue_business_hours_list_item_title,
body .jg-footer-row .ue_business_hours_list_item_text {
  font-size: var(--jg-footer-font-size) !important;
}


/* =========================================================
   ÜBERSCHRIFTEN
   ========================================================= */

body .jg-footer-row .elementor-heading-title,
body .jg-footer-row .ue_business_hours_header_title {
  font-size: calc(var(--jg-footer-font-size) * 1.05) !important;
}


/* =========================================================
   UNGEWOLLTE UMBRÜCHE VERMEIDEN
   ========================================================= */

body .jg-footer-customer .elementor-icon-list-text,
body .jg-footer-legal .elementor-icon-list-text {
  white-space: nowrap;
}


/* =========================================================
   MITTLERE DESKTOPBREITEN
   ========================================================= */

@media (max-width: 1450px) {
  body .jg-footer-row > .e-con-inner {
    grid-template-columns:
      minmax(230px, 290px)
      minmax(290px, 400px)
      clamp(5px, 1vw, 20px)
      minmax(165px, 1fr)
      minmax(165px, 1fr)
      minmax(max-content, 1fr);

    column-gap: clamp(15px, 1.5vw, 30px);
  }
}


/* =========================================================
   TABLET – ZWEI SPALTEN
   ========================================================= */

@media (max-width: 1024px) {
  body .jg-footer-row > .e-con-inner {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 35px 30px;

    padding-left: 20px !important;
    padding-right: 20px !important;
  }

  body .jg-footer-row > .e-con-inner > .jg-footer-location,
  body .jg-footer-row > .e-con-inner > .jg-footer-hours,
  body .jg-footer-row > .e-con-inner > .jg-footer-customer,
  body .jg-footer-row > .e-con-inner > .jg-footer-legal,
  body .jg-footer-row > .e-con-inner > .jg-footer-social {
    grid-column: auto;
  }

  body .jg-footer-row > .e-con-inner > .jg-footer-social {
    width: auto !important;
    min-width: 0 !important;
    justify-self: start !important;
  }
}


/* =========================================================
   SMARTPHONE – EINE SPALTE
   ========================================================= */

@media (max-width: 767px) {
  body .jg-footer-row > .e-con-inner {
    grid-template-columns: minmax(0, 1fr);
    gap: 30px;

    padding-left: 15px !important;
    padding-right: 15px !important;
  }

  body .jg-footer-row > .e-con-inner > .jg-footer-social {
    justify-self: start !important;
  }
}